	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.new(1, 0, 0, 22)
	hpText.Position = UDim2.new(0, 0, 0, 38)
	hpText.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	hpText.BackgroundTransparency = 0.25
	hpText.Text = "HP: 3000 / 3000 | DMG: 200"
	hpText.TextColor3 = Color3.fromRGB(255, 220, 120)
	hpText.Font = Enum.Font.GothamBold
	hpText.TextSize = 13
	hpText.Parent = billboard

	local hpCorner = Instance.new("UICorner")
	hpCorner.CornerRadius = UDim.new(0, 6)
	hpCorner.Parent = hpText

	bossModel.PrimaryPart = root
	bossModel.Parent = workspace

	-- ข้อความ boss appeared และคัดซีนเปิดตัวบอส
	BossBanner.Visible = true
	task.delay(3.5, function()
		if BossBanner then
			BossBanner.Visible = false
		end
	end)

	local originalCameraType = Camera.CameraType
	local originalCFrame = Camera.CFrame
	Camera.CameraType = Enum.CameraType.Scriptable

	task.spawn(function()
		local introElapsed = 0
		local introDuration = 2.2
		while introElapsed < introDuration and bossModel.Parent do
			local dt = RunService.RenderStepped:Wait()
			introElapsed += dt
			local angle = introElapsed * 1.6
			local camOffset = Vector3.new(math.cos(angle) * 22, 8, math.sin(angle) * 22)
			Camera.CFrame = CFrame.lookAt(root.Position + camOffset, root.Position + Vector3.new(0, 1.5, 0))
		end

		Camera.CameraType = originalCameraType
		Camera.CFrame = originalCFrame

		-- ลูปบอสหันเล็งและยิงเอฟเฟกต์กระสุน (ดาเมจ 200)
		while bossModel.Parent and humanoid.Health > 0 do
			hpText.Text = string.format("HP: %d / %d | DMG: %d", math.max(0, math.floor(humanoid.Health)), math.floor(humanoid.MaxHealth), bossDamage)

			local nearestTargetPos = nil
			local shortestDist = 220

			for _, plr in ipairs(Players:GetPlayers()) do
				local char = plr.Character
				local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
				local targetHum = char and char:FindFirstChildOfClass("Humanoid")
				if targetRoot and targetHum and targetHum.Health > 0 then
					local d = (targetRoot.Position - root.Position).Magnitude
					if d < shortestDist then
						shortestDist = d
						nearestTargetPos = targetRoot.Position
					end
				end
			end

			if nearestTargetPos then
				local lookPos = Vector3.new(nearestTargetPos.X, root.Position.Y, nearestTargetPos.Z)
				root.CFrame = CFrame.lookAt(root.Position, lookPos)

				local muzzlePos = gunPart.Position + gunPart.CFrame.LookVector * 1.8
				local dist = (nearestTargetPos - muzzlePos).Magnitude
				if dist > 2 then
					local tracer = Instance.new("Part")
					tracer.Anchored = true
					tracer.CanCollide = false
					tracer.Material = Enum.Material.Neon
					tracer.Color = Color3.fromRGB(255, 90, 40)
					tracer.Size = Vector3.new(0.25, 0.25, math.min(dist, 220))
					tracer.CFrame = CFrame.lookAt(muzzlePos, nearestTargetPos) * CFrame.new(0, 0, -math.min(dist, 220) / 2)
					tracer.Parent = workspace
					Debris:AddItem(tracer, 0.14)
				end
			end

			task.wait(0.85)
		end

		if bossModel.Parent then
			bossModel:Destroy()
		end
		if activeBossModel == bossModel then
			activeBossModel = nil
		end
		isBossSpawned = false
	end)
end

